# Скопируйте этот файл в .env и заполните
PORT=3000
# Пароль для входа в админку (обязательно смените)
ADMIN_PASSWORD=смените-этот-пароль
# Ключ Anthropic для ИИ-помощника. Без него работает встроенный бот с частыми вопросами
ANTHROPIC_API_KEY=
# Модель для помощника
AI_MODEL=claude-haiku-5-5

# Постоянный туннель Cloudflare (необязательно). Токен: панель Cloudflare, Networking > Tunnels, ваш туннель, Add a replica, строка на eyJ... Это как пароль: никому не показывайте.
TUNNEL_TOKEN=
# Публичный адрес, привязанный к туннелю, например https://arhiv.ваш-домен.com
PUBLIC_URL=
